node_modules/
lib/
build/
dist/
*.tsbuildinfo
.DS_Store
.env

# corum MCP tool npm cache (chrome-devtools-mcp 拉取隔离)
.npm-cache-mcp/

# pnpm store cache (dev artifact)
.pnpm-store/

# desktop shell dev/pack homes + electron cache (runtime artifacts)
.corum-dev-home/
.electron-cache/
packages/desktop/.corum-dev-home/
# 验证实例（scripts/verify-instance.sh）：Agent 自己的实例，运行文件同样不入库
packages/desktop/.corum-verify-home/
.corum-verify-home/
packages/desktop/.kkc-dev-home/
packages/desktop/.kkc-pack-home/
packages/desktop/.electron-cache/
packages/desktop/.corum-ide-home/

# runtime dev homes（Electron 跑出来的运行时状态，每次启动都变，不入库）
.corum-ide-home/
.corum-dev-home-ide/

# 用户级 preset 资产（属 $CORUM_HOME 运行时目录，非源码仓资产）
.agent-presets/

# .dbg 工作笔记的截图/二进制（md 调研笔记保留入库，图片不入库）
.dbg/**/*.png
.dbg/**/*.jpg
.dbg/**/*.jpeg

# .dbg 探针的整目录副本（app 安装目录级拷贝，GB 量级；可再生成）
# 2026-10-07 启动弹窗排查：Corum-fixed（修复验证物）/ Corum-probe（对照副本）
.dbg/popup-probe/Corum-*/

# 编排器隔离 worktree（运行时产物；可能是**用户 app 里正在跑的任务**，勿提交勿清理）
.corum-worktrees/

# 监督/排障的临时产物（可再生成，不入库）。项目产物请直接落项目目录，勿走 /tmp。
.corum-scratch/

# 监督/委派取证产物：规格、探针与 md 入库；二进制证据不入库（可再生成）
.dbg-evidence/**/*.png
.dbg-evidence/**/*.jpg
.dbg-evidence/**/*.jpeg

# docs/tasks/evidence/ 的截图同样不入库（2026-09-15 立规；历史里的 2 张 ~3.9MB 已 rebase 剔除）：
# 二进制一旦入库就永久占仓库体积且无法 diff；该目录的 spec / 报告 / md 仍然入库。
# 由来：监督侧在 6226f0f 误提交 before-codecard.png / before-full-page.png（各 ~1.9MB），
# 未 push 故改写安全；此后由本规则挡住复发。
docs/tasks/evidence/**/*.png
docs/tasks/evidence/**/*.jpg
docs/tasks/evidence/**/*.jpeg

# ── 工具/Agent 本地状态（2026-10-07：两个目录此前均未忽略，长期以未跟踪态污染 git status）──
.arts/
.workbuddy/

# ── 本地开发台账/设计稿（2026-10-04 开源前清理：本地保留、不再跟踪）──
docs/*
!docs/assets/
!docs/assets/wechat-group-qrcode.webp
!docs/fork-delta.md
!docs/archived-upstream-index.md
doc/
